# =====================================================
# Copy file này thành .env rồi điền giá trị.
# KHÔNG commit file .env lên Git.
# =====================================================

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=
REGION_CODE=VN
# Định danh máy crawl (chữ thường, số, _ hoặc -), ví dụ: ban
CRAWLER_ID=

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Chạy code trên máy: localhost:9000 | chạy trong container App: minio:9000
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=youtube-raw
MINIO_SECURE=false

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=youtube_trending_db

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

SAVE_LOCAL_COPY=
LOCAL_DATA_DIR=