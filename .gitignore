# ==========================================
# 1. BẢO MẬT & MẬT KHẨU (Security & Secrets)
# ==========================================
# Chứa API Key, Password Postgres/MinIO (không push lên Git)
.env
*.pem
*.key

# ==========================================
# 2. MÔI TRƯỜNG ẢO & PYTHON (Virtual Env & Cache)
# ==========================================
# Môi trường ảo managed bởi uv / venv
.venv/
venv/
ENV/
env/

# Bytecode Python & Cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.uv/

# ==========================================
# 3. DỮ LIỆU THÔ & FILE LOG (Data & Audit Logs)
# ==========================================
# Tránh push các file JSON thô cào về làm nặng Repository
data/raw/*
!data/raw/.gitkeep

# File log ghi vết lịch sử cào
logs/*.log

# ==========================================
# 4. CẤU HÌNH IDE & HỆ ĐIỀU HÀNH (OS & Editor)
# ==========================================
# Cấu hình riêng của VS Code / PyCharm
.vscode/
.idea/

# File rác do Windows / macOS tự tạo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini